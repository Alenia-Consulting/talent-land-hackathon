# Local development only (`npm run dev`). Copy to client/.env.local (git-ignored).
# Staging values come from kubernetes/overlays/staging/client/configmap.yaml, read at container start.
# NEXT_PUBLIC_* values are visible in the browser: never put secrets here.

# REST API base URL used by the browser. Default: /api, forwarded to API_PROXY_TARGET by `npm run dev`.
NEXT_PUBLIC_API_URL=/api

# Where `npm run dev` forwards /api (the FastAPI backend).
API_PROXY_TARGET=http://localhost:8000
