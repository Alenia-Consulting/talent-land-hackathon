# Local development only. Copy to api/.env (git-ignored). Staging values come from Vault.

# PostgreSQL (required by the API).
# docker compose: the postgres service reads POSTGRES_* and the API connects through the host
# "talent-land-hackathon-postgres" (same name as the Kubernetes Service).
# API on your machine (uvicorn / alembic from api/): replace that host with "localhost".
POSTGRES_USER=talent_land_hackathon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=talent_land_hackathon
DATABASE_URL=postgresql+psycopg://talent_land_hackathon:change-me@talent-land-hackathon-postgres:5432/talent_land_hackathon
