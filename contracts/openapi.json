{
  "openapi": "3.1.0",
  "info": {
    "title": "Antesala API",
    "summary": "Anticipation guides: a recorded route a person can watch before visiting a place.",
    "description": "Shared contract for the recorder (mobile), the review panel and the public player.\n\nThe route is **not** detected by the AI: the person picks the parts before recording and taps \"Llegue a: X\" on arrival. Those marks become the steps.\n\nTwo rules the API enforces, not the UI:\n- a guide is only published by a human, and only once every step is reviewed and complete\n- the public endpoint never serves a draft",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Behind nginx, in every environment"
    }
  ],
  "paths": {
    "/guides": {
      "post": {
        "tags": [
          "guides"
        ],
        "summary": "Create Guide",
        "description": "Create a guide from the parts the person marked while recording.\n\nThe steps arrive without text: Gemini writes it afterwards and a person reviews it. Nothing is\npublished here.",
        "operationId": "create_guide_guides_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuideCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "guides"
        ],
        "summary": "List Guides",
        "description": "One page of guides for the review panel, most recent first.",
        "operationId": "list_guides_guides_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GuideSummary"
                  },
                  "title": "Response List Guides Guides Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/guides/{guide_id}": {
      "get": {
        "tags": [
          "guides"
        ],
        "summary": "Read Guide",
        "description": "Read any guide, drafts included. For the review panel, not for visitors.",
        "operationId": "read_guide_guides__guide_id__get",
        "parameters": [
          {
            "name": "guide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Guide Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "guides"
        ],
        "summary": "Delete Guide",
        "description": "Remove a guide, published or not, with its steps and every file it keeps in storage.\n\nThe files go first: if storage refuses, the guide stays and can be deleted again, instead of\nleaving clips and photos of people nobody can reach any more. It cannot be undone.",
        "operationId": "delete_guide_guides__guide_id__delete",
        "parameters": [
          {
            "name": "guide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Guide Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/guides/{guide_id}/steps/{step_id}": {
      "patch": {
        "tags": [
          "guides"
        ],
        "summary": "Update Step",
        "description": "Apply the venue's corrections to one step.",
        "operationId": "update_step_guides__guide_id__steps__step_id__patch",
        "parameters": [
          {
            "name": "guide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Guide Id"
            }
          },
          {
            "name": "step_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Step Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StepPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/guides/{guide_id}/publish": {
      "post": {
        "tags": [
          "guides"
        ],
        "summary": "Publish Guide",
        "description": "Approve a reviewed guide and open its public link.",
        "operationId": "publish_guide_guides__guide_id__publish_post",
        "parameters": [
          {
            "name": "guide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Guide Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/public/guides": {
      "get": {
        "tags": [
          "guides"
        ],
        "summary": "List Public Guides",
        "description": "The catalogue a visitor browses when nobody sent them a link or showed them a QR.\n\nDeclared BEFORE /public/{slug}: FastAPI answers with the first route that matches, and the\nslug one would take this request and reply \"guide not found\".\n\nA larger page than the panel's: this one is read whole, not paged through.",
        "operationId": "list_public_guides_public_guides_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicGuideSummary"
                  },
                  "title": "Response List Public Guides Public Guides Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/public/{slug}": {
      "get": {
        "tags": [
          "guides"
        ],
        "summary": "Read Public Guide",
        "description": "The guide a visitor opens from the link or the QR code. Published guides only.",
        "operationId": "read_public_guide_public__slug__get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/guides/{guide_id}/routes": {
      "post": {
        "tags": [
          "guides"
        ],
        "summary": "Add Route",
        "description": "Add another recording to a guide that already exists.\n\nSame shape as creating a guide, minus the place: the marks become steps that continue the\nguide's numbering, and the video is sent afterwards to `/guides/{id}/routes/{route}/video`.\nNothing already in the guide is touched.",
        "operationId": "add_route_guides__guide_id__routes_post",
        "parameters": [
          {
            "name": "guide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Guide Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/guides/{guide_id}/video": {
      "post": {
        "tags": [
          "guides"
        ],
        "summary": "Upload Video",
        "description": "Send the video of the guide's latest route (the only one, for a guide with one).\n\nKept for the recorder, which sends one video per guide. See the route version below.",
        "operationId": "upload_video_guides__guide_id__video_post",
        "parameters": [
          {
            "name": "guide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Guide Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_video_guides__guide_id__video_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/guides/{guide_id}/routes/{route_id}/video": {
      "post": {
        "tags": [
          "guides"
        ],
        "summary": "Upload Route Video",
        "description": "Receive the recording of one route, blur the faces and store only the processed media.\n\nThe original never reaches storage and is deleted from this server either way: it shows the\nfaces of patients and staff who did not agree to be filmed. Answers 503 while the blurring is\nnot implemented, rather than storing a recording nobody has cleaned.",
        "operationId": "upload_route_video_guides__guide_id__routes__route_id__video_post",
        "parameters": [
          {
            "name": "guide_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Guide Id"
            }
          },
          {
            "name": "route_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Route Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_route_video_guides__guide_id__routes__route_id__video_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuideOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "description": "Answer as soon as the process is up. Does not touch the database.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Database connectivity check",
        "description": "Check the database answers. Returns 503 when it is unreachable or not configured.",
        "operationId": "health_db_health_db_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_route_video_guides__guide_id__routes__route_id__video_post": {
        "properties": {
          "video": {
            "type": "string",
            "format": "binary",
            "title": "Video",
            "description": "The recording, as taken by the phone."
          }
        },
        "type": "object",
        "required": [
          "video"
        ],
        "title": "Body_upload_route_video_guides__guide_id__routes__route_id__video_post"
      },
      "Body_upload_video_guides__guide_id__video_post": {
