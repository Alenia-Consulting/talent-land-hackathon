          "title",
          "venue_name",
          "status",
          "language",
          "processing_status",
          "public_slug",
          "qr_url",
          "reviewed_at",
          "video_duration_seconds",
          "walking_minutes",
          "cover_photo_url",
          "created_at",
          "updated_at",
          "routes",
          "steps"
        ],
        "title": "GuideOut"
