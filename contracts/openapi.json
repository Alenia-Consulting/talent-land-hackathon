      },
      "GuideCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "description": "Name of this guide: 'Recorrido principal', 'Sala de rayos X'."
          },
          "venue_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Venue Name"
          },
          "video_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Video Duration Seconds"
          },
          "marks": {
            "items": {
              "$ref": "#/components/schemas/MarkIn"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Marks",
            "description": "One per part reached, in order. Must move forward in time and all fall before video_duration_seconds. Each mark becomes a step running to the next."
          },
          "language": {
            "type": "string",
            "maxLength": 10,
            "title": "Language",
            "default": "es"
          }
        },
        "type": "object",
        "required": [
          "title",
          "venue_name",
          "video_duration_seconds",
          "marks"
        ],
        "title": "GuideCreate"
      },
