        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "venue_name": {
            "type": "string",
            "title": "Venue Name"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "draft | needs_review | published. Only a human moves it to published."
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "processing_status": {
            "type": "string",
            "title": "Processing Status",
            "description": "pending | processing | done | failed: where the recording is. A failed one can be sent again."
          },
          "public_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Slug",
            "description": "Segment of the public URL. Null until the guide is published."
          },
          "qr_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qr Url"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At",
            "description": "Last human review. The public guide always shows this date."
          },
          "video_duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Duration Seconds",
            "description": "Length of the recording."
          },
          "walking_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Walking Minutes",
            "description": "How long the whole route takes on foot."
          },
          "cover_photo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover Photo Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "routes": {
            "items": {
              "$ref": "#/components/schemas/RouteOut"
            },
            "type": "array",
            "title": "Routes",
            "description": "The guide's recordings, in order."
          },
          "steps": {
